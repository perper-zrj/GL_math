@article{ZhaoYanFei2026,
  title = {{基于人机交互的综采液压支架控制器结构模式设计研究}},
  author = {{赵艳飞}},
  year = 2026,
  journal = {机械管理开发},
  volume = {41},
  number = {9},
  pages = {220--221},
  doi = {10.16525/j.cnki.cn14-1134/th.2026.09.067},
  urldate = {2026-09-30},
  abstract = {针对现有控制器存在的操作力大、手感不清、长期使用易磨损等问题，提出一种基于人机工程学的新型机械式控制器结构。结果表明，优化后的控制器结构在满足强度与可靠性的前提下，平均操作力降低18.7\%，动作复位误差减少22.3\%，关键铰接点磨损寿命预估提升30.5\%。该结构具有操作轻便、反馈明确、耐久性高等特点，为综采液压支架控制器的机械性能提升提供了新的设计思路。},
  langid = {chinese},
